{
  "schema": "coverage-mcp/questions@2",
  "cases": [
    {
      "id": "next-gap",
      "question": "Which part of parse should I inspect?",
      "tool": "coverage_gaps",
      "arguments": {
        "measurement": "base.json",
        "query": "parse"
      },
      "expect": {
        "/data/status": "measured",
        "/data/group_count": 1,
        "/data/groups/0/locations/0/span/0": 2,
        "/data/measurement/coverage/total": 3
      }
    },
    {
      "id": "targeted-line",
      "question": "Is line 1 missing?",
      "tool": "coverage_gaps",
      "arguments": {
        "measurement": "base.json",
        "line": 1
      },
      "expect": {
        "/data/group_count": 0
      }
    },
    {
      "id": "missing-branch-detail",
      "question": "Which branch outcome is missing?",
      "tool": "coverage_gaps",
      "arguments": {
        "measurement": "base.json",
        "metric": "branches"
      },
      "expect": {
        "/data/status": "detail_unavailable"
      }
    },
    {
      "id": "subset-helped",
      "question": "Did this selected test add anything, ignoring unrelated absences?",
      "tool": "coverage_compare",
      "arguments": {
        "measurement": "candidate.json",
        "baseline": "base.json"
      },
      "expect": {
        "/data/status": "improved",
        "/data/changes/newly_observed": 1,
        "/data/changes/not_observed": 1,
        "/data/changes/regressed": null,
        "/data/scope": "selected_tests"
      }
    },
    {
      "id": "full-regressed",
      "question": "Did the full measurement lose covered behavior?",
      "tool": "coverage_compare",
      "arguments": {
        "measurement": "candidate.json",
        "baseline": "base.json",
        "scope": "full"
      },
      "expect": {
        "/data/status": "regression",
        "/data/changes/regressed": 1
      }
    },
    {
      "id": "zero-gain",
      "question": "Did an identical test measurement help?",
      "tool": "coverage_compare",
      "arguments": {
        "measurement": "identical.json",
        "baseline": "base.json"
      },
      "expect": {
        "/data/status": "no_gain",
        "/data/changes/newly_observed": 0
      }
    },
    {
      "id": "tests-failed",
      "question": "Can this successful coverage change be accepted when tests failed?",
      "tool": "coverage_compare",
      "arguments": {
        "measurement": "failed.json",
        "baseline": "base.json"
      },
      "expect": {
        "/data/status": "tests_failed",
        "/data/measurement/tests": "failed"
      }
    },
    {
      "id": "unverified-report",
      "question": "Can a raw report establish a full regression?",
      "tool": "coverage_compare",
      "arguments": {
        "measurement": "unverified.json",
        "baseline": "base.json",
        "scope": "full"
      },
      "expect": {
        "/data/status": "limited",
        "/data/changes/regressed": null
      }
    },
    {
      "id": "missing-report",
      "question": "What happens when the test runner did not produce a report?",
      "tool": "coverage_gaps",
      "arguments": {
        "measurement": "missing.json"
      },
      "error": true
    },
    {
      "id": "removed-workflow",
      "question": "Does the server still execute registered commands?",
      "tool": "run_test",
      "arguments": {},
      "error": true
    },
    {
      "id": "invalid-budget",
      "question": "Are impossible display limits rejected?",
      "tool": "coverage_gaps",
      "arguments": {
        "measurement": "base.json",
        "limit": 0
      },
      "error": true
    },
    {
      "id": "unknown-input",
      "question": "Are mistaken arguments rejected rather than ignored?",
      "tool": "coverage_gaps",
      "arguments": {
        "measurement": "base.json",
        "task": "source"
      },
      "error": true
    },
    {
      "id": "incremental-union",
      "tool": "coverage_compare",
      "arguments": {
        "baseline": "base.json",
        "measurement": "candidate.json",
        "scope": "incremental"
      },
      "expect": {
        "/data/status": "improved",
        "/data/incremental/newly_covered": 1,
        "/data/incremental/combined/covered": 3,
        "/data/incremental/combined/total": 3,
        "/data/remaining_group_count": 0,
        "/data/regression_checked": false
      }
    },
    {
      "id": "incremental-repeat",
      "tool": "coverage_compare",
      "arguments": {
        "baseline": "base.json",
        "measurement": "candidate.json",
        "scope": "incremental",
        "previous": [
          "candidate.json"
        ]
      },
      "expect": {
        "/data/status": "no_gain",
        "/data/incremental/newly_covered": 0,
        "/data/incremental/combined/covered": 3
      }
    },
    {
      "id": "incremental-failed",
      "tool": "coverage_compare",
      "arguments": {
        "baseline": "base.json",
        "measurement": "failed.json",
        "scope": "incremental"
      },
      "expect": {
        "/data/status": "tests_failed",
        "/data/incremental": null
      }
    },
    {
      "id": "incremental-estimate",
      "tool": "coverage_compare",
      "arguments": {
        "baseline": "base.json",
        "measurement": "unverified.json",
        "scope": "incremental"
      },
      "expect": {
        "/data/status": "limited",
        "/data/incremental/evidence": "unverified"
      }
    }
  ]
}
